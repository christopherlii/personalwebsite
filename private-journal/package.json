{
  "name": "christopher-private-journal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:links": "node test/browser-links.mjs",
    "test:reading": "node test/browser-reading.mjs",
    "test:tags": "node test/browser-tags.mjs",
    "test:dictation": "node test/browser-dictation.mjs",
    "test:photos": "node test/browser-photos.mjs",
    "test:shelf": "node test/browser-shelf.mjs",
    "test:essays": "node test/browser-essays.mjs",
    "db:local": "wrangler d1 migrations apply JOURNAL_DB --local",
    "password": "node scripts/password.mjs",
    "deploy": "wrangler deploy --env production",
    "build:editor": "node scripts/build-editor.mjs",
    "predev": "npm run build:editor",
    "predeploy": "npm run build:editor"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "pdfjs-dist": "6.4.299",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0"
  }
}
